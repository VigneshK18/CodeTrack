# Copy this file to .env and fill in your MySQL details.

PORT=8080

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=codetrack_java

# Set DB_SSL=true for cloud MySQL (Aiven, TiDB Cloud, Railway...).
# Optionally paste the provider's CA certificate on one line with \n for line breaks.
DB_SSL=false
DB_SSL_CA=

# JWT - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=1d

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Create tables and seed demo data on startup (true/false)
AUTO_SEED=true

# Java code runner limits
RUN_TIMEOUT_MS=5000
COMPILE_TIMEOUT_MS=15000
