# Copy this file to .env and fill in your MySQL details.

PORT=8080

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=codetrack_java

# Set DB_SSL=true for cloud MySQL (Aiven, TiDB Cloud, Railway...).
# Optionally paste the provider's CA certificate on one line with \n for line breaks.
DB_SSL=false
DB_SSL_CA=

# Time zone for dates, streaks and the heatmap (e.g. +05:30 for India)
DB_TIMEZONE=+00:00

# JWT - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=1d

# Frontend URL(s) allowed by CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Create tables and seed demo data on startup (true/false)
AUTO_SEED=true

# Java judge limits: CPU time per test case, compile time, and how many
# submissions are judged at the same time (each uses up to 256 MB of memory)
RUN_TIMEOUT_MS=2000
COMPILE_TIMEOUT_MS=30000
JUDGE_CONCURRENCY=1
